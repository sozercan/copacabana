FROM aquasec/trivy:0.76.1 AS trivy

FROM alpine:3.22 AS notation
ARG NOTATION_VERSION=1.3.2
RUN wget -qO- https://github.com/notaryproject/notation/releases/download/v${NOTATION_VERSION}/notation_${NOTATION_VERSION}_linux_amd64.tar.gz \
    | tar -xz -C /usr/local/bin notation

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=trivy /usr/local/bin/trivy /usr/local/bin/trivy
COPY --from=notation /usr/local/bin/notation /usr/local/bin/notation
COPY copa copa-worker /usr/local/bin/
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/copa-worker"]
